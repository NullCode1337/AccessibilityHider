<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
         No <activity> declared anywhere in this manifest. There is nothing
         to launch, so no launcher icon and nothing to select in the scope
         picker other than the module's own (invisible) app entry.
    -->
    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:hasCode="true"
        android:icon="@android:drawable/sym_def_app_icon">

        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />

    </application>

</manifest>
